# PostgreSQL Docker Configuration
# This file contains environment variables for the PostgreSQL container

# PostgreSQL Server Configuration
POSTGRES_DB=insomea_db
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=my_secure_password

# Connection Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=insomea_db
DB_USER=dev_user
DB_PASSWORD=my_secure_password
DB_SCHEMA=insomea_tech

# Connection for applications inside Docker network
DATABASE_URL=postgresql://dev_user:my_secure_password@postgres:5432/insomea_db

# Connection for applications on host machine
DATABASE_URL_HOST=postgresql://dev_user:my_secure_password@127.0.0.1:5432/insomea_db

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@insomea.com
PGADMIN_DEFAULT_PASSWORD=admin

# Timezone
TZ=UTC
